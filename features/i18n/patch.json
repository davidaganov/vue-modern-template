{
  "name": "i18n",
  "requires": [],
  "copy": [
    "src/i18n/locales/en.json",
    "src/i18n/locales/ru.json",
    "src/components/ui/UiLanguageSwitcher.vue",
    "src/types/enums/locales.enum.ts",
    "src/types/locales.interface.ts",
    "src/types/enums/index.ts",
    "src/types/index.ts"
  ],
  "patches": [
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:import",
      "lines": [
        "import { createI18n } from \"vue-i18n\"",
        "import { LOCALES } from \"@/types/enums/locales.enum\"",
        "import enMessages from \"@/i18n/locales/en.json\"",
        "import ruMessages from \"@/i18n/locales/ru.json\""
      ]
    },
    {
      "file": "src/main.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:use",
      "lines": [
        "const i18n = createI18n({",
        "  legacy: false,",
        "  locale: LOCALES.EN,",
        "  fallbackLocale: LOCALES.EN,",
        "  messages: {",
        "    [LOCALES.EN]: enMessages,",
        "    [LOCALES.RU]: ruMessages",
        "  }",
        "})",
        "app.use(i18n)"
      ]
    },
    {
      "file": "src/types/enums/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:enum-exports",
      "lines": [
        "export * from \"./locales.enum\""
      ]
    },
    {
      "file": "src/types/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:type-exports",
      "lines": [
        "export * from \"./locales.interface\""
      ]
    },
    {
      "file": ".env.example",
      "action": "replace-marker",
      "marker": "# Example environment variables for this project",
      "lines": [
        "VITE_POLYGLOT_API_KEY=your_api_key_here"
      ]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-badge -->Template v{{ appVersion }}",
      "lines": [
        "{{ $t(\"home.badge\", { version: appVersion }) }}"
      ]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-title -->\n        Modern Vue",
      "lines": [
        "<!-- @webstack:hero-title -->",
        "        {{ $t(\"home.hero.title\") }}"
      ]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-subtitle -->Starter Template",
      "lines": [
        "{{ $t(\"home.hero.subtitle\") }}"
      ]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-description -->\n      A clean, performant Vue 3 starter template with TypeScript and optimized developer experience.",
      "lines": [
        "<!-- @webstack:hero-description -->",
        "      {{ $t(\"home.hero.description\") }}"
      ]
    },
    {
      "file": "src/components/pages/home/HomeActions.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:home-actions-get-started -->Get Started",
      "lines": [
        "{{ $t(\"home.actions.getStarted\") }}"
      ]
    },
    {
      "file": "src/components/pages/home/HomeActions.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:home-actions-read-more -->Read More",
      "lines": [
        "{{ $t(\"home.actions.readMore\") }}"
      ]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-title -->About",
      "lines": [
        "{{ $t(\"about.title\") }}"
      ]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-description -->\n      This template is a starting point for your modern Vue 3 project.",
      "lines": [
        "<!-- @webstack:about-description -->",
        "      {{ $t(\"about.description\") }}"
      ]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-return-button -->← Return",
      "lines": [
        "{{ $t(\"about.returnButton\") }}"
      ]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:about-info-imports",
      "lines": [
        "import { useI18n } from \"vue-i18n\"",
        "",
        "const { t } = useI18n()"
      ]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "replace-marker",
      "marker": "  // @webstack:about-features\n  { title: \"Modern Vue 3\", icon: \"⚡\" },\n  { title: \"TypeScript\", icon: \"📘\" },\n  { title: \"Performance\", icon: \"🚀\" },\n  { title: \"Modern Styling\", icon: \"🎨\" }",
      "lines": [
        "  { title: t(\"about.features.i18n\"), icon: \"🌍\" },",
        "  { title: t(\"about.features.tailwind\"), icon: \"🎨\" },",
        "  { title: t(\"about.features.pinia\"), icon: \"📦\" },",
        "  { title: t(\"about.features.tests\"), icon: \"🧪\" }"
      ]
    },
    {
      "file": "src/layouts/default.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:layout-imports",
      "lines": [
        "import UiLanguageSwitcher from \"@/components/ui/UiLanguageSwitcher.vue\""
      ]
    },
    {
      "file": "src/layouts/default.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:layout-top-bar -->",
      "lines": [
        "<UiLanguageSwitcher />"
      ]
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-imports",
      "lines": [
        "import { createI18n } from \"vue-i18n\"",
        "import enMessages from \"@/i18n/locales/en.json\"",
        "import ruMessages from \"@/i18n/locales/ru.json\""
      ],
      "optional": true
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-type-imports",
      "lines": [
        "import { LOCALES } from \"@/types\""
      ],
      "optional": true
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-init",
      "lines": [
        "const i18n = createI18n({",
        "  legacy: false,",
        "  locale: LOCALES.EN,",
        "  fallbackLocale: LOCALES.EN,",
        "  messages: {",
        "    [LOCALES.EN]: enMessages,",
        "    [LOCALES.RU]: ruMessages",
        "  }",
        "})"
      ],
      "optional": true
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:utils-plugins",
      "lines": [
        "i18n,"
      ],
      "optional": true
    }
  ],
  "packageJson": {
    "dependencies": [
      "vue-i18n"
    ],
    "devDependencies": [
      "polyglot-keeper"
    ],
    "scripts": {
      "translate": "polyglot-keeper sync"
    }
  }
}
